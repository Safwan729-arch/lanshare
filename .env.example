# Copy to .env and adjust. All values are optional; these are the defaults.

# Network
LANSHARE_HOST=0.0.0.0
LANSHARE_PORT=8080

# Shown to other devices as the host PC's name
LANSHARE_SERVER_NAME=LANShare PC

# Extra hostnames this server may be reached under.
#
# Addresses (192.168.1.20), single-label machine names (DESKTOP-7F2K1) and the
# reserved local suffixes (.local, .lan, .home.arpa, .internal) are always
# accepted. An ordinary registrable domain is refused with 400, because that is
# what a DNS rebinding attack needs: a page on the internet pointing its own
# domain at 127.0.0.1 so the browser treats this server as same-origin with it,
# and loopback is trusted on sight here. If you front LANShare with a real name
# - a Tailscale address, a reverse proxy - list it. Comma-separated.
# LANSHARE_ALLOWED_HOSTS=files.example.com,pc.tail1234.ts.net

# Where completed files land. Relative paths resolve against the repo root.
# Point this at a real folder if you prefer, e.g. C:/Users/You/Downloads/LANShare
LANSHARE_INCOMING_DIR=storage/incoming
LANSHARE_TEMPORARY_DIR=storage/temporary
LANSHARE_DATA_DIR=data

# How many devices may sit unapproved at once. Registration cannot require a
# credential - a device needs an identity before anyone can approve it - so
# this is what stops a LAN neighbour burying your phone in the approval list.
# Loopback registers as trusted and is never counted, so the host cannot be
# locked out by a flood.
LANSHARE_MAX_PENDING_DEVICES=20

# Transfer tuning
#
# CHUNK_SIZE is the *smallest* chunk used, not a fixed one. Resume state is
# derived by listing the chunk directory once per uploaded chunk, so the cost
# of a transfer grows with the square of the chunk count. The server therefore
# doubles the chunk size per transfer until the file fits in 4096 chunks:
#
#   up to  16 GiB ->  4 MiB chunks   (unchanged from earlier versions)
#          32 GiB ->  8 MiB
#          64 GiB -> 16 MiB
#         128 GiB -> 32 MiB
#         256 GiB -> 64 MiB          (the ceiling: 64 MiB x 4096)
#
# Bigger chunks cost resume granularity - a dropped connection re-sends the
# whole chunk - so raising CHUNK_SIZE is rarely what you want. Lower it if you
# are on a flaky link and send small files.
LANSHARE_CHUNK_SIZE=4194304

# How long an unfinished upload keeps its partial chunks, in hours.
#
# Resume lives in the page: the browser holds the transfer id in memory and
# never writes it down, so a closed tab cannot pick an upload back up - it
# starts a new transfer. At startup, anything still unfinished and older than
# this is marked failed and its chunks are deleted. The window is only there so
# that restarting the server under an open page does not discard an upload that
# page can still finish.
LANSHARE_STALE_TRANSFER_HOURS=24

# Per-file ceiling, 256 GiB. This is also the largest value accepted: past it
# the chunk count climbs again and directory scanning dominates the transfer.
#
# Disk cost: assembly needs roughly 2x the file size free, or 3x when
# INCOMING_DIR and TEMPORARY_DIR are on different drives.
LANSHARE_MAX_FILE_SIZE=274877906944

# mDNS: advertise the server as <hostname>.local on the LAN.
# Works on Apple devices out of the box; most Android browsers cannot resolve
# .local names, so the IP address stays the address to rely on.
LANSHARE_ENABLE_MDNS=true
LANSHARE_MDNS_HOSTNAME=lanshare

# UDP broadcast: find OTHER LANShare servers on the LAN.
# Server-to-server only - browsers cannot open raw sockets, so this has no
# effect on how phones reach this server.
LANSHARE_ENABLE_UDP_DISCOVERY=true
LANSHARE_DISCOVERY_PORT=8079
LANSHARE_ANNOUNCE_INTERVAL_SECONDS=10
LANSHARE_PEER_TTL_SECONDS=35

# --- Security ---------------------------------------------------------------
# Devices are approved on the host. The browser at http://localhost:8080 is
# trusted automatically; everything arriving over the LAN must be approved.
#
# HTTPS is off by default: a self-signed certificate means a browser warning on
# every device and a trust profile to install on iOS. Turn it on when you want a
# secure context (crypto.subtle, the Clipboard API). Certificates are supplied,
# not generated - see the README for the openssl command.
LANSHARE_ENABLE_HTTPS=false
# LANSHARE_SSL_CERTFILE=cert.pem
# LANSHARE_SSL_KEYFILE=key.pem
